{
  "manifest_version": 3,
  "name": "YouTube Ledger",
  "version": "0.6.3",
  "description": "Local YouTube playback history with foreground, background and idle time.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://m.youtube.com/*"
  ],
  "background": {
    "scripts": [
      "compat.js",
      "core.js",
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*"
      ],
      "css": [
        "recommendations.css"
      ],
      "js": [
        "compat.js",
        "core.js",
        "recommendations.js",
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "Open YouTube Ledger"
  },
  "incognito": "not_allowed",
  "browser_specific_settings": {
    "gecko": {
      "id": "youtube-ledger@local.example",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
