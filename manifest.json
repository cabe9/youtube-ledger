{
  "manifest_version": 3,
  "name": "YouTube Ledger",
  "version": "0.8.0",
  "description": "Local YouTube playback history with foreground, background and idle time.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://m.youtube.com/*"
  ],
  "background": {
    "scripts": [
      "compat.js",
      "core.js",
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*"
      ],
      "css": [
        "recommendations.css"
      ],
      "js": [
        "compat.js",
        "core.js",
        "recommendations.js",
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "Open YouTube Ledger",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "incognito": "not_allowed",
  "browser_specific_settings": {
    "gecko": {
      "id": "youtube-ledger@local.example",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "64": "icons/icon-64.png",
    "128": "icons/icon-128.png",
    "256": "icons/icon-256.png"
  }
}
